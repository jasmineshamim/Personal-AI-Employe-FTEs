# AI Employee - Gold Tier Environment Variables
# Copy this file to .env and fill in your actual values

# ===========================================
# ODOO ERP (Local - Docker)
# ===========================================
# Default credentials for local Odoo instance
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

# ===========================================
# LINKEDIN
# ===========================================
# Get these from https://www.linkedin.com/developers/
# 1. Create an app on LinkedIn Developer Portal
# 2. Add "Sign In with LinkedIn" and "Marketing Developer Platform" products
# 3. Configure OAuth 2.0 settings (Redirect URL)
# 4. Generate Client ID and Client Secret
# 5. Generate Access Token using OAuth 2.0 flow
# 6. Get your Company URN from LinkedIn API (organization ID)

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
COMPANY_URN=your_company_urn

# ===========================================
# FACEBOOK & INSTAGRAM
# ===========================================
# Get these from https://developers.facebook.com/
# 1. Create a Business app
# 2. Add Facebook Login product
# 3. Generate Page Access Token

FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# Optional: Instagram Business account
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# ===========================================
# TWITTER / X
# ===========================================
# Get these from https://developer.twitter.com/
# 1. Create a project
# 2. Create an app
# 3. Generate API keys

TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_token_secret_here
TWITTER_BEARER_TOKEN=your_bearer_token_here

# ===========================================
# GMAIL (Silver Tier - Already configured)
# ===========================================
# Keep your existing Gmail credentials
GMAIL_CREDENTIALS_PATH=credentials.json

# ===========================================
# LINKEDIN (Silver Tier - Already configured)
# ===========================================
# Keep your existing LinkedIn session

# ===========================================
# GENERAL SETTINGS
# ===========================================
# Dry run mode (prevents actual actions during testing)
DRY_RUN=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Check interval for watchers (seconds)
WATCHER_INTERVAL=300
